{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aitrading-app",
  "main": "aitrading-app.js",
  "account_id": "61b0828673501d7247e50a5c7c2a1cc8",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
